# ClassQuest API settings. Copy to backend/.env for local dev; in Dokploy set
# these as Environment variables on the classquest-api application.
# Names are the UPPERCASE of the fields in app/config.py. Every value is
# optional: the defaults below are what you get when a key is unset.
# Rule: an empty optional secret switches the feature off, it never raises.

# Directory for the sqlite db and uploads. Docker image sets /data (mount a volume there).
DATA_DIR=./.data

# SQLAlchemy URL. Leave blank to derive sqlite:///<DATA_DIR>/classquest.db.
DATABASE_URL=

# Secret for signing JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me

# Token lifetime in hours (168 = 7 days).
JWT_EXPIRE_HOURS=168

# Comma-separated browser origins allowed by CORS (the web app's URL(s)).
CORS_ORIGINS=http://localhost:5173,https://classquest.net

# Public base URL of this API, used in the OpenAPI servers list (prod: https://api.classquest.net).
PUBLIC_API_URL=http://localhost:8000

# LLM key. Blank = fixture mode: serves the hand-written fixtures, no API calls. CI runs this way.
LLM_API_KEY=

# Anthropic-compatible endpoint the anthropic SDK points at.
LLM_BASE_URL=https://api.minimax.io/anthropic

# Model name sent to LLM_BASE_URL.
LLM_MODEL=MiniMax-M3

# Seconds to wait for a world-generation LLM call.
LLM_TIMEOUT_S=120

# Seconds to wait for an in-game explanation LLM call (kept under typical proxy timeouts).
LLM_EXPLAIN_TIMEOUT_S=55

# Abuse controls for a publicly-shared link. Defaults are the production
# values; only the test suite turns the limiter off.
RATE_LIMIT_ENABLED=true

# Read the caller's address from the rightmost X-Forwarded-For hop. True behind
# Traefik/Dokploy; set false if nothing proxies this app, where the header is
# pure attacker input.
TRUST_FORWARDED_FOR=true

# Courses one account may own. Each one is a generation run.
MAX_SERVERS_PER_USER=5

# Generation threads allowed at once, across everyone.
MAX_CONCURRENT_GENERATIONS=3

# Max worlds a single course can generate.
MAX_WORLDS=6

# Characters per content segment fed to the generator.
SEGMENT_CHARS=1500

# Max size of a single uploaded file, in MB.
MAX_UPLOAD_MB=10

# Max number of files per upload.
MAX_FILES=10

# Max total extracted characters across an upload (bigger is rejected).
MAX_TOTAL_CHARS=400000

# Min total extracted characters for an upload to be usable.
MIN_TOTAL_CHARS=400

# Create the demo server/world on startup (true/false). Set false in tests.
SEED_DEMO=true

# Server the seeded classmate cohort joins. Blank = the seeded demo server
# (join code DEMO01). Set it to a real server id to make that classroom look
# alive instead. An unknown or not-ready id is a logged warning, not an error.
DEMO_COHORT_SERVER_ID=

# SCHEMA_DIR / FIXTURES_DIR default to <repo>/schema and <repo>/fixtures and
# are set to /app/schema and /app/fixtures by the Dockerfile. Override only if
# you move those directories.
# SCHEMA_DIR=
# FIXTURES_DIR=
