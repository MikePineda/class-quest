# Base URL of the ClassQuest API.
# - Dev: leave UNSET so the client uses the Vite `/api` proxy (see vite.config.ts,
#   which forwards to VITE_API_PROXY or http://localhost:8000).
# - Prod: passed as a Docker build-arg (baked into the bundle at `vite build`).
VITE_API_URL=http://localhost:8000

# Dev only: where the `/api` proxy forwards to (defaults to http://localhost:8000).
# VITE_API_PROXY=https://api.classquest.net
